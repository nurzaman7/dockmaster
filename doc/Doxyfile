# Public API reference. Run from the repository root:  doxygen doc/Doxyfile

PROJECT_NAME           = Dockmaster
PROJECT_BRIEF          = "Firmware QoS for multi-radio Cortex-M devices on Zephyr"
OUTPUT_DIRECTORY       = doc/_build/doxygen
INPUT                  = include/dockmaster
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __packed= \
                         "BIT(n)=(1UL << (n))" \
                         CONFIG_DM_MAX_MSG=240 \
                         __cplusplus=0
HAVE_DOT               = NO
